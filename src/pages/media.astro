---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { u } from '../lib/url';
import { photos } from '../data/photos';
const videos = ['Clinic talk', 'Game highlights', 'Interview'];
const filters = ['All', 'Football', 'Baseball', 'Family'];
---
<Base title="Media">
  <PageHero page="media" />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Gallery</p><h2>Photos</h2></div>
        <div class="filters" role="group" aria-label="Filter photos">
          {filters.map((f, i) => <button class:list={['filter', { on: i === 0 }]} data-f={f}>{f}</button>)}
        </div>
      </div>
      <div class="gallery">
        {photos.map((p) => (
          <a href={u(`/images/photos/${p.file}`)} data-sport={p.sport} class="g-item">
            <img src={u(`/images/photos/${p.file}`)} alt={p.alt} loading="lazy" />
            <span>{p.caption}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <p class="eyebrow">Watch</p>
      <h2>Videos</h2>
      <div class="grid grid-3" style="margin-top: 24px">
        {videos.map((s) => (
          <div class="card" style="padding: 0; overflow: hidden">
            <div class="photo-placeholder" style="aspect-ratio: 16/9; min-height: 0; border-radius: 0">{s}</div>
            <div style="padding: 20px"><h3>{s}</h3><p>Placeholder. Add a video link.</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('.g-item'));
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    btns.forEach((x) => x.classList.toggle('on', x === b));
    items.forEach((i) => { i.hidden = !(f === 'All' || i.dataset.sport === f); });
  }));
</script>

<style>
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .filter {
    font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.9rem;
    border: 2px solid var(--ink); background: transparent; color: var(--ink); padding: 6px 16px; border-radius: 999px; cursor: pointer;
  }
  .filter.on, .filter:hover { background: var(--ink); color: var(--cream); }
  .gallery { columns: 3 280px; column-gap: 16px; }
  .g-item { display: block; break-inside: avoid; margin-bottom: 16px; position: relative; border-radius: var(--radius); overflow: hidden; }
  .g-item[hidden] { display: none; }
  .g-item img { width: 100%; transition: transform 0.3s; }
  .g-item:hover img { transform: scale(1.03); }
  .g-item span {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 24px 14px 10px; color: var(--white);
    background: linear-gradient(transparent, rgba(0,0,0,0.65)); font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.9rem;
  }
</style>
