---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { u } from '../lib/url';
import { site, stats, timeline, bio, quickFacts } from '../data/site';
---
<Base title="About">
  <PageHero eyebrow="My Story" title={site.fullName} lead={site.philosophy} image="fist-bump.jpg" position="80% 22%" />

  <section class="section">
    <div class="container about-row">
      <img class="headshot" src={u("/images/headshot.jpg")} alt={`${site.fullName} headshot`} width="880" height="1200" />
      <div class="prose">
        <h2 style="margin-top:0">Bio</h2>
        {bio.map((para) => <p>{para}</p>)}
        <h2>Quick Facts</h2>
        <dl class="facts">
          {quickFacts.map((f) => (<><dt>{f.label}</dt><dd>{f.value}</dd></>))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container family-row">
      <img class="family-photo" src={u('/images/photos/family.jpg')} alt="Coach Rowling with his wife and daughter on the field" loading="lazy" />
      <div>
        <p class="eyebrow">Off the field</p>
        <h2>Family</h2>
        <p>Coaching is a family commitment. His wife is all in on the program, and these days their daughter is on the sideline too.</p>
      </div>
    </div>
  </section>

  <section class="section section--clay">
    <div class="container stats">
      {stats.map((s) => (
        <div class="stat"><span class="stat-value">{s.value}</span><span class="stat-label">{s.label}</span></div>
      ))}
    </div>
  </section>

  <section class="section" id="timeline">
    <div class="container">
      <p class="eyebrow">History</p>
      <h2>Career Timeline</h2>
      <ol class="timeline">
        {timeline.map((t) => (
          <li>
            <span class="t-year">{t.year}</span>
            <div><h3>{t.title}</h3><p>{t.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 8px 20px; margin: 0; }
  .facts dt { font-weight: 600; }
  .facts dd { margin: 0; color: var(--ink-soft); }
  @media (max-width: 520px) { .facts { grid-template-columns: 1fr; gap: 2px; } .facts dd { margin-bottom: 10px; } }
  .headshot { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; border-radius: var(--radius); }
  .family-row { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; }
  .family-photo { width: 100%; border-radius: var(--radius); }
  @media (max-width: 820px) { .family-row { grid-template-columns: 1fr; } }
  .about-row { display: grid; grid-template-columns: 1fr 1.6fr; gap: 48px; align-items: start; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px; }
  .stat { display: flex; flex-direction: column; }
  .stat-value { font-family: var(--font-head); font-size: clamp(2.6rem, 6vw, 3.6rem); line-height: 1; }
  .stat-label { text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.9rem; margin-top: 6px; }
  .timeline { list-style: none; padding: 0; margin: 32px 0 0; border-left: 3px solid var(--clay); }
  .timeline li { display: grid; grid-template-columns: 90px 1fr; gap: 16px; padding: 0 0 32px 24px; position: relative; }
  .timeline li::before { content: ''; position: absolute; left: -10px; top: 6px; width: 17px; height: 17px; border-radius: 50%; background: var(--cream); border: 3px solid var(--clay); }
  .t-year { font-family: var(--font-head); font-size: 1.4rem; color: var(--clay); }
  .timeline h3 { margin: 0 0 4px; }
  .timeline p { margin: 0; color: var(--ink-soft); }
  @media (max-width: 820px) {
    .about-row { grid-template-columns: 1fr; }
    .timeline li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
