---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('playbook');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <PageHero eyebrow={`${entry.data.sport} · ${entry.data.type}`} title={entry.data.title} lead={entry.data.summary} />
  <section class="section">
    <div class="container prose">
      <Content />
      <p style="margin-top: 48px"><a class="link-arrow" href={u("/playbook/")}>Back to the Playbook</a></p>
    </div>
  </section>
</Base>
