---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('playbook')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const sports = ['All', 'Football', 'Baseball', 'General'];
---
<Base title="Playbook">
  <PageHero eyebrow="Coaching materials" title="Playbook" lead="Drills, practice plans, systems and program-building materials for football and baseball." image="sideline-coaching.jpg" />

  <section class="section">
    <div class="container">
      <div class="toolbar">
        <div class="filters" role="group" aria-label="Filter by sport">
          {sports.map((s, i) => <button class:list={['filter', { on: i === 0 }]} data-sport={s}>{s}</button>)}
        </div>
        <input class="search" type="search" placeholder="Search the playbook" aria-label="Search the playbook" />
      </div>
      <div class="grid grid-3" id="playbook-grid">
        {items.map((p) => (
          <article class="card" data-sport={p.data.sport} data-text={`${p.data.title} ${p.data.summary} ${p.data.type}`.toLowerCase()}>
            <span class="meta">{p.data.type}</span>
            <h3><a href={u(`/playbook/${p.id}/`)}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
            <div><span class="tag">{p.data.sport}</span></div>
          </article>
        ))}
      </div>
      <p class="empty" hidden>No materials match that search.</p>
      <p class="note" style="margin-top: 40px">Private materials for players and staff will live behind a login. That part comes in a later step.</p>
    </div>
  </section>
</Base>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#playbook-grid .card'));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
  const search = document.querySelector<HTMLInputElement>('.search');
  const empty = document.querySelector<HTMLElement>('.empty');
  let sport = 'All';
  function apply() {
    const q = (search?.value || '').trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const ok = (sport === 'All' || c.dataset.sport === sport) && (!q || (c.dataset.text || '').includes(q));
      c.hidden = !ok;
      if (ok) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  }
  buttons.forEach((b) => b.addEventListener('click', () => {
    sport = b.dataset.sport || 'All';
    buttons.forEach((x) => x.classList.toggle('on', x === b));
    apply();
  }));
  search?.addEventListener('input', apply);
</script>

<style>
  .toolbar { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 32px; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .filter {
    font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.9rem;
    border: 2px solid var(--ink); background: transparent; color: var(--ink); padding: 6px 16px; border-radius: 999px; cursor: pointer;
  }
  .filter.on, .filter:hover { background: var(--ink); color: var(--cream); }
  .search { font: inherit; padding: 8px 16px; border: 2px solid var(--sand); border-radius: 999px; min-width: 0; width: min(320px, 100%); background: var(--white); }
  .card[hidden] { display: none; }
</style>
