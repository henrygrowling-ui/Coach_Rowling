---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { u } from '../lib/url';

// GitHub Pages can't receive form posts, so Web3Forms (web3forms.com) emails each message to Coach.
// The access key only lets people send to that inbox; Web3Forms says it is safe to publish.
const formAction = 'https://api.web3forms.com/submit';
const web3formsKey = 'd8edebb0-4274-4e8b-a870-1bf35115d800';
const thanksUrl = new URL(u('/contact/thanks/'), Astro.site ?? Astro.url).href;
---
<Base title="Contact">
  <PageHero page="contact" />
  <section class="section">
    <div class="container contact-row">
      <div class="prose">
        <h2 style="margin-top: 0">Ways to Work Together</h2>
        <ul>
          <li>Coaching clinics and staff development</li>
          <li>Youth camps</li>
          <li>Speaking to teams, schools and groups</li>
        </ul>
        <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <form class="card contact-form" name="contact" method="POST" action={formAction}>
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="subject" value={`New message from the ${site.name} website`} />
        <input type="hidden" name="from_name" value={`${site.name} website`} />
        <input type="hidden" name="redirect" value={thanksUrl} />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label>Name<input name="name" required /></label>
        <label>Email<input type="email" name="email" required /></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <button class="btn" type="submit">Send</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact-row { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .contact-form label { display: flex; flex-direction: column; gap: 4px; font-weight: 600; }
  .contact-form input, .contact-form textarea { font: inherit; padding: 10px 12px; border: 2px solid var(--sand); border-radius: 8px; }
  .contact-form .btn { align-self: flex-start; cursor: pointer; }
  .contact-form .hp { position: absolute; left: -9999px; }
  @media (max-width: 820px) { .contact-row { grid-template-columns: 1fr; } }
</style>
