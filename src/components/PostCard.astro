---
interface Props { href: string; title: string; summary: string; meta?: string; tags?: string[]; }
const { href, title, summary, meta, tags = [] } = Astro.props;
---
<article class="card">
  {meta && <span class="meta">{meta}</span>}
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  {tags.length > 0 && <div>{tags.map((t) => <span class="tag">{t}</span>)}</div>}
</article>
