---
import '../styles/global.css';
import { site, nav } from '../data/site';
import { u, stripBase } from '../lib/url';

interface Props { title?: string; description?: string; }
const { title, description = site.philosophy } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const path = stripBase(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={u('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#1d2a33" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={u("/")}>
          <span class="brand-mark">R</span>
          <span class="brand-text">{site.name}</span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={u(item.href)} class:list={[{ active: isActive(item.href) }]}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <p class="footer-brand">{site.name}</p>
          <p class="footer-tag">{site.tagline}</p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          {nav.map((item) => <a href={u(item.href)}>{item.label}</a>)}
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} {site.fullName}. All rights reserved.</span>
      </div>
    </footer>

    <script>
      const btn = document.querySelector('.menu-toggle');
      const navEl = document.getElementById('site-nav');
      btn?.addEventListener('click', () => {
        const open = navEl?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(Boolean(open)));
      });
    </script>
  </body>
</html>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--ink); color: var(--cream); border-bottom: 3px solid var(--clay); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--cream); text-decoration: none; }
  .brand-mark {
    width: 38px; height: 38px; border-radius: 50%; background: var(--clay); display: grid; place-items: center;
    font-family: var(--font-head); font-size: 1.3rem;
  }
  .brand-text { font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.1em; font-size: 1.15rem; }
  .site-nav { display: flex; gap: 4px; flex-wrap: wrap; }
  .site-nav a {
    color: var(--cream); text-decoration: none; font-family: var(--font-head); text-transform: uppercase;
    letter-spacing: 0.08em; font-size: 0.92rem; padding: 8px 12px; border-radius: 6px;
  }
  .site-nav a:hover { background: rgba(255,255,255,0.08); color: var(--white); }
  .site-nav a.active { color: var(--white); box-shadow: inset 0 -3px 0 var(--clay); border-radius: 0; }
  .menu-toggle {
    display: none; background: transparent; color: var(--cream); border: 2px solid var(--cream); border-radius: 6px;
    font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.08em; padding: 6px 14px; cursor: pointer;
  }
  @media (max-width: 920px) {
    .menu-toggle { display: block; }
    .site-nav {
      display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column;
      background: var(--ink); padding: 8px 16px 16px; border-bottom: 3px solid var(--clay);
    }
    .site-nav.open { display: flex; }
    .site-nav a { padding: 12px 8px; border-bottom: 1px solid rgba(255,255,255,0.08); }
  }
  .site-footer { background: var(--ink); color: var(--sand); padding: 48px 0 24px; }
  .footer-inner { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .footer-brand { font-family: var(--font-head); text-transform: uppercase; letter-spacing: 0.1em; font-size: 1.3rem; color: var(--cream); margin: 0; }
  .footer-tag { margin: 4px 0 0; }
  .footer-nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .footer-nav a { color: var(--sand); text-decoration: none; }
  .footer-nav a:hover { color: var(--white); }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,0.12); margin-top: 32px; padding-top: 16px; font-size: 0.85rem; }
</style>
